# ─── API (apps/api) ────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000

# Postgres exposé par docker-compose sur 5433 (évite le conflit avec un PG local)
#
# DATABASE_URL        : rôle applicatif ordinaire → la Row Level Security s'applique.
# DIRECT_DATABASE_URL : rôle propriétaire → migrations uniquement. Un
#                       superutilisateur contourne la RLS : ne jamais l'utiliser
#                       pour les requêtes de l'API.
DATABASE_URL=postgresql://caisse_app:caisse_app@localhost:5433/caisse?schema=public
DIRECT_DATABASE_URL=postgresql://caisse:caisse@localhost:5433/caisse?schema=public

# Secrets JWT — à régénérer en production (openssl rand -base64 48)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d

# ─── Desktop (apps/desktop) ────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
