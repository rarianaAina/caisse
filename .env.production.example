# ============================================================================
# Configuration de production — à copier en `.env.production` et à remplir.
#
#   cp .env.production.example .env.production
#
# Ce fichier contient les secrets du serveur : il n'est JAMAIS versionné
# (cf. .gitignore) et doit être lisible par le seul administrateur :
#
#   chmod 600 .env.production
#
# Générer chaque secret séparément :
#
#   openssl rand -base64 48   # secrets JWT
#   openssl rand -base64 24   # mots de passe de base
# ============================================================================

# ─── Domaine et certificat ─────────────────────────────────────────────────
# Le nom doit déjà pointer (enregistrement DNS de type A) vers ce serveur :
# Caddy demande le certificat au premier démarrage et échoue sinon.
API_DOMAIN=api.mondomaine.mg
# Adresse à laquelle Let's Encrypt prévient d'un renouvellement en échec.
# Utiliser une adresse réellement relevée.
ACME_EMAIL=admin@mondomaine.mg

# ─── PostgreSQL ────────────────────────────────────────────────────────────
# Rôle propriétaire : migrations uniquement. Il contourne la RLS.
POSTGRES_USER=caisse
POSTGRES_PASSWORD=
POSTGRES_DB=caisse

# Rôle applicatif ordinaire, soumis à la Row Level Security. C'est celui qu'emploie
# l'API à l'exécution ; il est créé au premier démarrage avec ce mot de passe.
APP_DB_PASSWORD=

# ─── Jetons ────────────────────────────────────────────────────────────────
# L'API refuse de démarrer si ces valeurs sont celles du développement.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
# 30 jours : une caisse restée longtemps hors ligne doit pouvoir se
# resynchroniser sans qu'on retourne saisir un mot de passe sur place.
JWT_REFRESH_TTL=30d

# ─── Divers ────────────────────────────────────────────────────────────────
# Origines de NAVIGATEUR autorisées à appeler l'API, séparées par des virgules —
# en pratique, l'adresse du back-office. Elles s'AJOUTENT à celles de
# l'application de caisse, qui restent toujours autorisées : renseigner cette
# variable ne peut donc pas couper le parc.
#   ex. CORS_ORIGINS=https://admin.mondomaine.mg
CORS_ORIGINS=

# Heure UTC de la sauvegarde quotidienne (Madagascar = UTC+3 : 02 → 5 h locales)
# et nombre de copies conservées.
HEURE_SAUVEGARDE=02
JOURS_CONSERVES=14
