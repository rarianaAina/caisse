{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* NestJS compile en CommonJS et s'appuie sur les décorateurs :
       ces options écrasent volontairement la base (pensée pour Vite/ESM). */
    "module": "commonjs",
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
