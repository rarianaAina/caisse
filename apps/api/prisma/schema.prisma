// ============================================================================
// Base serveur PostgreSQL — miroir du schéma SQLite local, plus :
//   * le cloisonnement multi-tenant (company_id partout + RLS)
//   * le journal de changements global (change_log) qui alimente le pull
//   * l'idempotence du push (processed_mutation)
//   * les secrets (hash de mot de passe, refresh tokens) qui ne descendent jamais
//     sur un poste de caisse
//
// Les valeurs d'énumération sont volontairement typées `String` et non `enum`
// Prisma : @caisse/shared reste l'unique source de vérité des unions de valeurs.
// Les contraintes CHECK correspondantes sont posées par la migration
// `..._hardening` (Prisma ne les modélise pas, mais ne les supprime pas non plus).
//
// ⚠️ LES MIGRATIONS SONT ÉCRITES À LA MAIN. N'utilisez que `prisma migrate
//    deploy`, jamais `migrate dev` ni `db push`.
//
//    Ce fichier décrit le schéma ; les migrations le CONSTRUISENT, en SQL brut,
//    avec des index et des contraintes que Prisma ne modélise pas toujours. Tout
//    ce qui n'est pas déclaré ici, Prisma le tient pour une dérive et l'efface
//    dans la migration qu'il engendre. C'est arrivé à `ix_product_parent`, créé
//    par `..._variantes` et absent d'ici : une migration engendrée l'a supprimé
//    sans que rien ne le signale. Il est désormais déclaré (cf. modèle Product).
//
//    Une dérive subsiste, tolérée : les clés étrangères écrites en SQL brut n'ont
//    pas `ON UPDATE CASCADE`, que Prisma souhaiterait. Sans effet ici — les clés
//    primaires sont des UUID, jamais modifiés.
//
// ⚠️ NE PASSEZ JAMAIS `DIRECT_DATABASE_URL` COMME `--shadow-database-url`.
//    Prisma RÉINITIALISE la base fantôme : pointée sur la vraie base, elle en
//    efface le contenu. Pour comparer sans risque, donnez une base jetable.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Exécution : rôle ordinaire `caisse_app`, soumis à la Row Level Security.
  url       = env("DATABASE_URL")
  // Migrations : rôle propriétaire. Un superutilisateur contourne la RLS, il ne
  // doit donc JAMAIS servir aux requêtes applicatives.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── Multi-tenant ───────────────────────────────────────────────────────────

model Company {
  id               String    @id @db.Uuid
  name             String
  currency         String    @default("EUR") @db.Char(3)
  country          String?   @db.Char(2)
  pricesIncludeTax Boolean   @default(true) @map("prices_include_tax")
  plan             String    @default("free")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  version          Int       @default(1)

  stores    Store[]
  registers Register[]
  devices   Device[]
  users     User[]
  categories Category[]
  products  Product[]
  movements StockMovement[]
  sessions  CashSession[]
  sales     Sale[]
  changes   ChangeLog[]
  customers Customer[]
  accountMovements CustomerAccountMovement[]
  suppliers Supplier[]
  promotions Promotion[]
  heldCarts HeldCart[]
  receipts  PurchaseReceipt[]

  @@map("company")
}

model Store {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  code      String
  address   String?
  phone     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  registers   Register[]
  devices     Device[]
  userStores  UserStore[]
  levels      StockLevel[]
  movements   StockMovement[]
  sessions    CashSession[]
  sales       Sale[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("store")
}

model Register {
  id            String    @id @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  name          String
  receiptPrefix String    @map("receipt_prefix")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  version       Int       @default(1)

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  devices  Device[]
  sessions CashSession[]
  sales    Sale[]

  @@unique([storeId, receiptPrefix])
  @@index([companyId])
  @@map("register")
}

/// Un poste physique sur lequel l'application desktop est installée.
model Device {
  id         String    @id @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  storeId    String?   @map("store_id") @db.Uuid
  registerId String?   @map("register_id") @db.Uuid
  name       String
  platform   String?
  appVersion String?   @map("app_version")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store         Store?         @relation(fields: [storeId], references: [id])
  register      Register?      @relation(fields: [registerId], references: [id])
  refreshTokens RefreshToken[]
  syncState     SyncState?

  @@index([companyId])
  @@map("device")
}

// ─── Utilisateurs ───────────────────────────────────────────────────────────

model User {
  id        String  @id @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  /// Identifiant de connexion, unique sur toute l'instance : la recherche à
  /// l'ouverture de session a lieu AVANT que le tenant soit connu. Mis à NULL
  /// lors d'une suppression logique, pour libérer l'adresse.
  email     String? @unique
  fullName  String  @map("full_name")
  /// 'owner' | 'manager' | 'cashier' — cf. USER_ROLES dans @caisse/shared
  role         String
  /// argon2id — ne descend JAMAIS dans la base locale d'un poste
  passwordHash String?   @map("password_hash")
  /// PIN d'ouverture de session hors-ligne (argon2id également)
  pinHash      String?   @map("pin_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  version      Int       @default(1)

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userStores    UserStore[]
  refreshTokens RefreshToken[]
  movements     StockMovement[]
  sales         Sale[]
  openedSessions CashSession[]  @relation("SessionOpenedBy")
  closedSessions CashSession[]  @relation("SessionClosedBy")

  @@index([companyId])
  @@map("app_user")
}

model UserStore {
  userId  String @map("user_id") @db.Uuid
  storeId String @map("store_id") @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@map("user_store")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  deviceId  String?   @map("device_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@map("refresh_token")
}

// ─── Catalogue ──────────────────────────────────────────────────────────────

model Category {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String
  color     String?
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([companyId, position])
  @@map("category")
}

model Product {
  id          String    @id @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  /// Mis à NULL lors d'une suppression logique pour libérer la référence
  sku         String?
  barcode     String?
  name        String
  description String?
  /// 'unit' | 'kg' | 'g' | 'l' | 'm' | 'h' — cf. PRODUCT_UNITS
  unit        String    @default("unit")
  priceCents  Int       @map("price_cents")
  costCents   Int       @default(0) @map("cost_cents")
  taxRateBp   Int       @default(0) @map("tax_rate_bp")
  trackStock  Boolean   @default(true) @map("track_stock")
  isActive    Boolean   @default(true) @map("is_active")
  imagePath   String?   @map("image_path")
  /// Déclinaison : « Vis 4×40 » rattachée à « Vis à bois ». Une déclinaison
  /// reste un produit à part entière ; seul ce lien les regroupe à l'écran.
  /// Vendre au-delà du stock. Vrai par défaut : cf. ADR 0003-B.
  allowNegativeStock Boolean @default(true) @map("allow_negative_stock")
  parentId     String?  @map("parent_id") @db.Uuid
  variantLabel String?  @map("variant_label")
  /// Fournisseur habituel. Colonne simple et non relation : les achats sont
  /// tenus localement par la caisse (cf. ADR 0015), le serveur ne fait que
  /// transporter la référence pour qu'une deuxième caisse la retrouve.
  supplierId   String?  @map("supplier_id") @db.Uuid
  /// Tarif gros. NULL = cet article ne se vend qu'au détail. Un SECOND prix
  /// plutôt qu'une grille de barèmes : au comptoir on applique deux prix.
  wholesalePriceCents  Int? @map("wholesale_price_cents")
  /// Quantité déclenchant le tarif gros, en milli-unités. 0 = jamais
  /// automatiquement — réservé aux clients professionnels.
  wholesaleMinQtyMilli Int  @default(0) @map("wholesale_min_qty_milli")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  version     Int       @default(1)

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  Category?       @relation(fields: [categoryId], references: [id])
  levels    StockLevel[]
  movements StockMovement[]
  saleItems SaleItem[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, categoryId])
  @@index([companyId, name])
  // Déclaré ici ALORS QU'il est créé en SQL brut par la migration
  // `20260811090000_variantes`. Sans cette ligne, Prisma ne connaît pas
  // l'index, le tient pour une dérive, et l'efface à la première migration
  // engendrée — ce qui est arrivé. `map` reprend son nom d'origine pour ne pas
  // en créer un second sous un autre nom.
  @@index([parentId], map: "ix_product_parent")
  @@map("product")
}

// ─── Stock ──────────────────────────────────────────────────────────────────

/// Journal append-only : SOURCE DE VÉRITÉ du stock, donc jamais en conflit.
model StockMovement {
  id            String   @id @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  /// 'initial' | 'purchase' | 'sale' | 'return' | 'adjustment'
  /// | 'transfer_in' | 'transfer_out' | 'loss'
  type          String
  /// Delta signé, en milli-unités : -1000 pour la vente d'une unité
  qtyMilliDelta BigInt   @map("qty_milli_delta")
  reason        String?
  refType       String?  @map("ref_type")
  refId         String?  @map("ref_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId, storeId, createdAt])
  @@index([refType, refId])
  @@map("stock_movement")
}

/// Cache recalculable par sommation des mouvements ; jamais synchronisé tel quel.
model StockLevel {
  productId   String   @map("product_id") @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  qtyMilli    BigInt   @default(0) @map("qty_milli")
  minQtyMilli BigInt   @default(0) @map("min_qty_milli")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([productId, storeId])
  @@map("stock_level")
}

// ─── Caisse ─────────────────────────────────────────────────────────────────

model CashSession {
  id                String    @id @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  storeId           String    @map("store_id") @db.Uuid
  registerId        String    @map("register_id") @db.Uuid
  openedBy          String    @map("opened_by") @db.Uuid
  openedAt          DateTime  @map("opened_at") @db.Timestamptz(3)
  openingFloatCents Int       @default(0) @map("opening_float_cents")
  closedBy          String?   @map("closed_by") @db.Uuid
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  countedCents      Int?      @map("counted_cents")
  expectedCents     Int?      @map("expected_cents")
  differenceCents   Int?      @map("difference_cents")
  /// Billetage d'ouverture, JSON { "20000": 3, "1000": 12 }. NULL = non saisi.
  openingCount      String?   @map("opening_count")
  /// Billetage de clôture. NULL = le total a été saisi directement.
  closingCount      String?   @map("closing_count")
  /// 'open' | 'closed'
  status            String    @default("open")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  version           Int       @default(1)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  register Register @relation(fields: [registerId], references: [id], onDelete: Cascade)
  opener   User     @relation("SessionOpenedBy", fields: [openedBy], references: [id])
  closer   User?    @relation("SessionClosedBy", fields: [closedBy], references: [id])
  sales    Sale[]

  @@index([registerId, status])
  @@map("cash_session")
}

/// Immuable après création : on annule (`voided`) ou on crée une vente de
/// remboursement qui la référence, on ne la modifie jamais.
model Sale {
  id              String    @id @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  registerId      String    @map("register_id") @db.Uuid
  cashSessionId   String?   @map("cash_session_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  receiptNumber   String    @map("receipt_number")
  /// Compteur monotone sans trou, par caisse — base de la traçabilité fiscale
  seqInRegister   Int       @map("seq_in_register")
  /// 'completed' | 'voided' | 'refunded' | 'partially_refunded'
  status          String    @default("completed")
  subtotalCents   Int       @map("subtotal_cents")
  discountCents   Int       @default(0) @map("discount_cents")
  taxCents        Int       @default(0) @map("tax_cents")
  totalCents      Int       @map("total_cents")
  currency        String    @db.Char(3)
  refundOfSaleId  String?   @map("refund_of_sale_id") @db.Uuid
  /// Client à qui la vente est portée ; NULL pour un passage anonyme, qui reste
  /// le cas majoritaire. Renseigné obligatoirement dès qu'un règlement est
  /// « à crédit » — une créance sans débiteur n'est pas une créance.
  customerId      String?   @map("customer_id") @db.Uuid
  note            String?
  soldAt          DateTime  @map("sold_at") @db.Timestamptz(3)
  /// Chaînage fiscal (NF525 & équivalents) : prêt, non alimenté au MVP
  prevHash        String?   @map("prev_hash")
  signature       String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  version         Int       @default(1)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  register    Register     @relation(fields: [registerId], references: [id], onDelete: Cascade)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  refundOf    Sale?        @relation("SaleRefund", fields: [refundOfSaleId], references: [id])
  refunds     Sale[]       @relation("SaleRefund")
  items       SaleItem[]
  payments    Payment[]

  @@unique([registerId, receiptNumber])
  @@unique([registerId, seqInRegister])
  @@index([storeId, soldAt])
  @@index([cashSessionId])
  @@index([customerId])
  @@map("sale")
}

/// Valeurs produit figées à l'instant de la vente : modifier un prix au
/// catalogue ne doit jamais réécrire l'historique.
model SaleItem {
  id             String  @id @db.Uuid
  saleId         String  @map("sale_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid
  nameSnapshot   String  @map("name_snapshot")
  skuSnapshot    String? @map("sku_snapshot")
  unitPriceCents Int     @map("unit_price_cents")
  qtyMilli       BigInt  @map("qty_milli")
  discountCents  Int     @default(0) @map("discount_cents")
  taxRateBp      Int     @default(0) @map("tax_rate_bp")
  taxCents       Int     @default(0) @map("tax_cents")
  lineTotalCents Int     @map("line_total_cents")
  position       Int     @default(0)
  /// Promotion appliquée, NOM compris : un ticket doit rester explicable des
  /// mois plus tard, même si l'opération a été supprimée depuis.
  promotionId    String? @map("promotion_id") @db.Uuid
  promotionName  String? @map("promotion_name")

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_item")
}

model Payment {
  id            String   @id @db.Uuid
  saleId        String   @map("sale_id") @db.Uuid
  /// 'cash' | 'card' | 'mobile' | 'voucher' | 'credit'
  method        String
  amountCents   Int      @map("amount_cents")
  tenderedCents Int?     @map("tendered_cents")
  changeCents   Int?     @map("change_cents")
  reference     String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payment")
}

// ─── Achats ─────────────────────────────────────────────────────────────────

/// Fournisseur.
///
/// `product.supplier_id` circulait dans le protocole de synchronisation depuis
/// les déclinaisons, mais la table ne suivait pas : une deuxième caisse
/// recevait un identifiant qui ne pointait sur rien. Le serveur ne fait que
/// transporter — les réceptions restent tenues localement (ADR 0015).
model Supplier {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  note      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, name])
  @@map("supplier")
}

/// Bon de réception VALIDÉ.
///
/// Seules les réceptions validées remontent : un brouillon est un travail en
/// cours, comme un panier. Une fois validée, la pièce ne bouge plus (ADR 0015-B)
/// et se transporte donc exactement comme une vente — en création pure, sans
/// conflit possible.
///
/// Le serveur ne recalcule AUCUN stock à partir d'elle : les mouvements de type
/// `purchase` remontent séparément et font foi. La réception n'est ici que le
/// document qui explique d'où vient l'entrée.
model PurchaseReceipt {
  id          String    @id @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  supplierId  String?   @map("supplier_id") @db.Uuid
  reference   String?
  /// 'draft' | 'received' | 'cancelled' — seul 'received' est jamais transmis
  status      String    @default("received")
  totalCents  Int       @map("total_cents")
  currency    String    @db.Char(3)
  note        String?
  receivedAt  DateTime? @map("received_at") @db.Timestamptz(3)
  receivedBy  String?   @map("received_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  version     Int       @default(1)

  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PurchaseReceiptItem[]

  @@index([companyId, storeId, receivedAt])
  @@map("purchase_receipt")
}

model PurchaseReceiptItem {
  id             String @id @db.Uuid
  receiptId      String @map("receipt_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  qtyMilli       BigInt @map("qty_milli")
  /// Prix d'achat de CETTE livraison : il varie d'une réception à l'autre, et
  /// c'est précisément ce qu'on veut pouvoir comparer dans le temps.
  unitCostCents  Int    @map("unit_cost_cents")
  lineTotalCents Int    @map("line_total_cents")
  position       Int    @default(0)

  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("purchase_receipt_item")
}

// ─── Clients et ardoise ─────────────────────────────────────────────────────

/// Client connu du commerce. Ne devient utile qu'avec l'ardoise : un passage
/// anonyme n'a aucune raison d'être enregistré, et l'imposer ralentirait chaque
/// encaissement pour servir une minorité de tickets.
model Customer {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  phone     String?
  email     String?
  address   String?
  note      String?
  /// NULL = crédit illimité, 0 = aucun crédit. La distinction est commerciale :
  /// le défaut prudent est 0.
  creditLimitCents Int? @default(0) @map("credit_limit_cents")
  /// Client professionnel : prix de gros dès la première unité.
  wholesale        Boolean @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  version   Int       @default(1)

  company   Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements CustomerAccountMovement[]
  sales     Sale[]

  @@index([companyId, name])
  @@index([companyId, phone])
  @@map("customer")
}

/// Journal APPEND-ONLY du compte client : le solde en est la somme, jamais une
/// colonne. Deux caisses hors-ligne y ajoutent des lignes qui s'additionnent au
/// lieu de s'écraser — une ardoise ne peut donc pas entrer en conflit, et un
/// solde reste justifiable ligne à ligne devant le client qui le conteste.
model CustomerAccountMovement {
  id            String   @id @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  /// 'opening' | 'sale_credit' | 'payment' | 'adjustment'
  type          String
  /// SIGNÉ : positif quand le client doit davantage, négatif quand il rembourse
  amountCents   Int      @map("amount_cents")
  /// Moyen du remboursement ; NULL sur une vente à crédit
  method        String?
  /// Session de caisse du règlement : une ardoise réglée en espèces remplit le
  /// tiroir sans qu'aucune vente ne l'explique
  cashSessionId String?  @map("cash_session_id") @db.Uuid
  refType       String?  @map("ref_type")
  refId         String?  @map("ref_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  note          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([cashSessionId])
  @@index([refType, refId])
  @@map("customer_account_movement")
}

// ─── Promotions ─────────────────────────────────────────────────────────────

/// Opération commerciale : remise automatique sur un article ou un rayon.
///
/// Elle produit une REMISE DE LIGNE, calculée par la caisse avant son moteur de
/// panier — lequel n'est pas modifié. Une seule s'applique par article, la plus
/// avantageuse : les cumuler rendrait un ticket inexplicable au client qui le
/// conteste.
model Promotion {
  id          String    @id @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  /// 'pourcentage' | 'montant' | 'quantite'
  kind        String
  /// Cible : un article OU une catégorie. Les deux à NULL et la promotion ne
  /// s'applique à rien — délibérément : une remise générale accidentelle sur
  /// tout le magasin ne se rattrape pas.
  productId   String?   @map("product_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  /// Points de base, comme la TVA : 1000 = 10 %
  percentBp   Int       @default(0) @map("percent_bp")
  /// Remise par UNITÉ vendue, pas par ticket
  amountCents Int       @default(0) @map("amount_cents")
  buyQty      Int       @default(0) @map("buy_qty")
  payQty      Int       @default(0) @map("pay_qty")
  /// Bornes INCLUSES : une opération qui finit le 31 vaut tout le 31
  startsAt    String?   @map("starts_at")
  endsAt      String?   @map("ends_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  version     Int       @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
  @@map("promotion")
}

// ─── Devis ──────────────────────────────────────────────────────────────────

/// Panier mis de côté. Seuls les DEVIS remontent ici : une attente de comptoir
/// vit quelques minutes sur son poste et n'a rien à faire dans un journal de
/// synchronisation.
///
/// Les lignes sont du JSON et non une table fille : c'est un BROUILLON, rien
/// n'y est comptable et personne n'interroge « les lignes de tous les devis ».
/// Une table fille aurait imposé des clés étrangères vers des produits qui
/// peuvent disparaître — or un devis doit rester lisible même alors.
model HeldCart {
  id          String    @id @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  registerId  String    @map("register_id") @db.Uuid
  /// 'attente' | 'devis' — en pratique toujours 'devis' côté serveur
  kind        String
  label       String
  customerId  String?   @map("customer_id") @db.Uuid
  lines       String
  currency    String    @db.Char(3)
  totalCents  Int       @default(0) @map("total_cents")
  note        String?
  validUntil  String?   @map("valid_until")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  version     Int       @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, kind])
  @@map("held_cart")
}

// ─── Synchronisation ────────────────────────────────────────────────────────

/// Journal global ordonné : c'est la source du PULL. Un seul curseur (`seq`)
/// suffit au client pour savoir où il en est, toutes entités confondues.
model ChangeLog {
  seq            BigInt   @id @default(autoincrement())
  companyId      String   @map("company_id") @db.Uuid
  storeId        String?  @map("store_id") @db.Uuid
  entity         String
  entityId       String   @map("entity_id") @db.Uuid
  /// 'create' | 'update' | 'delete'
  op             String
  /// État COMPLET de la ligne après application, en camelCase
  payload        Json
  /// Champs réellement modifiés par cette écriture. Sans cette liste, le
  /// serveur ne pourrait pas dire à une caisse en retard ce qu'IL a changé
  /// depuis, et la fusion par champ serait impossible.
  changedFields  String[] @map("changed_fields")
  version        Int
  /// Permet au client d'ignorer ses propres écritures au retour
  originDeviceId String?  @map("origin_device_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, seq])
  @@index([companyId, storeId, seq])
  @@map("change_log")
}

/// Idempotence du PUSH : un rejeu réseau ne duplique jamais une vente.
model ProcessedMutation {
  mutationId String   @id @map("mutation_id") @db.Uuid
  deviceId   String   @map("device_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  entity     String
  entityId   String   @map("entity_id") @db.Uuid
  /// 'applied' | 'ignored' | 'merged' | 'conflict' | 'rejected'
  result     String
  /// Réponse d'origine, rejouée à l'identique si la mutation est renvoyée
  response   Json?
  appliedAt  DateTime @default(now()) @map("applied_at") @db.Timestamptz(3)

  @@index([companyId, appliedAt])
  @@map("processed_mutation")
}

/// Observabilité : où en est chaque poste.
model SyncState {
  deviceId     String    @id @map("device_id") @db.Uuid
  lastPushAt   DateTime? @map("last_push_at") @db.Timestamptz(3)
  lastPullSeq  BigInt    @default(0) @map("last_pull_seq")
  pendingCount Int       @default(0) @map("pending_count")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("sync_state")
}

/// Limitation des tentatives de connexion, PARTAGÉE entre les instances de l'API.
///
/// POURQUOI EN BASE ET NON EN MÉMOIRE : le compteur en mémoire disparaissait au
/// redémarrage et n'était pas partagé. Deux exemplaires de l'API derrière un
/// répartiteur divisaient donc la protection par deux — sans aucun signal, et
/// précisément sur la route la plus exposée d'Internet.
///
/// Pas de `company_id` : la clé est consultée AVANT que le tenant soit connu,
/// comme `auth_lookup_user`. Il n'y a donc rien à cloisonner, et aucune RLS.
model LoginAttempt {
  /// « <e-mail normalisé>|<ip> » — cf. LoginThrottleService.key()
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("login_attempt")
}
